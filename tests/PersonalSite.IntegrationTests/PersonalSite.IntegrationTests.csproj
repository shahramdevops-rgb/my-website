<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables, run via Microsoft.Testing.Platform (see global.json). -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- No tests yet, so don't fail on MTP exit code 8 ("zero tests ran"). Remove in P0-T6 with the first smoke test. -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <!-- WebApplicationFactory + Testcontainers come in P0-T6. -->

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PersonalSite.Web\PersonalSite.Web.csproj" />
  </ItemGroup>

</Project>
