# Text files are LF in the repo AND in the working copy (matches .editorconfig `end_of_line = lf`),
# regardless of a machine's core.autocrlf setting. Without eol=lf, Git for Windows checks out CRLF
# and `dotnet format --verify-no-changes` fails.
* text=auto eol=lf

# Shell scripts must stay LF (they run on the Linux server / in containers).
*.sh text eol=lf
Dockerfile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
Caddyfile text eol=lf
*.caddy text eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.sln text eol=crlf

# Binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
