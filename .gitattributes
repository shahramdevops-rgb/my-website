# Normalize line endings in the repo (LF), let Git convert on checkout.
* text=auto

# Shell scripts must stay LF (they run on the Linux server / in containers).
*.sh text eol=lf
Dockerfile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
Caddyfile text eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.sln text eol=crlf

# Binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
