{
  "openapi": "3.1.1",
  "info": {
    "title": "PersonalSite API",
    "description": "JSON API behind the personal site of Mahdi Azghandi.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/site": {
      "get": {
        "tags": [
          "Site"
        ],
        "summary": "Site name, contact links and public feature flags.",
        "operationId": "GetSite",
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteInfoDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/resume": {
      "get": {
        "tags": [
          "Resume"
        ],
        "summary": "The structured résumé in one language.",
        "operationId": "GetResume",
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "fa",
                "en"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumeProfile"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Signs the admin in and sets the session cookie.",
        "operationId": "Login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Ends the admin session and clears the cookie.",
        "operationId": "Logout",
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "The signed-in admin, or 401.",
        "operationId": "GetCurrentAdmin",
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentAdminDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/dashboard": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Counts for the admin dashboard.",
        "operationId": "GetAdminDashboard",
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminDashboardDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminDashboardDto": {
        "required": [
          "posts",
          "projects",
          "pendingComments",
          "unreadMessages",
          "subscribers"
        ],
        "type": "object",
        "properties": {
          "posts": {
            "type": "integer",
            "format": "int32"
          },
          "projects": {
            "type": "integer",
            "format": "int32"
          },
          "pendingComments": {
            "type": "integer",
            "format": "int32"
          },
          "unreadMessages": {
            "type": "integer",
            "format": "int32"
          },
          "subscribers": {
            "type": "integer",
            "format": "int32"
          }
        },
        "description": "Counts on the admin dashboard; each links to its admin page (P5-T5)."
      },
      "CurrentAdminDto": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "description": "Answer of `GET /api/auth/me`: who is signed in to the admin panel."
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "description": "Body of `POST /api/auth/login`."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PublicFeaturesDto": {
        "required": [
          "newsletterSignup",
          "comments",
          "analytics",
          "semanticSearch"
        ],
        "type": "object",
        "properties": {
          "newsletterSignup": {
            "type": "boolean"
          },
          "comments": {
            "type": "boolean"
          },
          "analytics": {
            "type": "boolean"
          },
          "semanticSearch": {
            "type": "boolean"
          }
        },
        "description": "Only the flags that change what a visitor sees. Back-office flags (`Newsletter.Sending`,\n`Notifications.Email`, `Ai.AdminAssistant` …) stay private: they are nobody else's business."
      },
      "ResumeBasics": {
        "required": [
          "name",
          "headline",
          "summary",
          "location"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "headline": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "location": {
            "type": "string"
          }
        },
        "description": "Who: name (ADR-017), one-line headline, short summary, location."
      },
      "ResumeEducation": {
        "required": [
          "institution",
          "degree",
          "field",
          "start"
        ],
        "type": "object",
        "properties": {
          "institution": {
            "type": "string"
          },
          "degree": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "A degree. `end` = `null` means \"in progress\"."
      },
      "ResumeExperience": {
        "required": [
          "organization",
          "role",
          "start",
          "summary",
          "highlights",
          "tech"
        ],
        "type": "object",
        "properties": {
          "organization": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "start": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tech": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "end": {
            "type": [
              "null",
              "string"
            ]
          },
          "location": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "A job or engagement. `end` = `null` means \"present\". `tech` holds ids from\n`techStack`, so the keyboard hero can list the work that used each technology."
      },
      "ResumeLink": {
        "required": [
          "label",
          "url"
        ],
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "description": "A public profile or page (e.g. GitHub). Absolute https URL."
      },
      "ResumeProfile": {
        "required": [
          "basics",
          "links",
          "experience",
          "education",
          "skills",
          "techStack"
        ],
        "type": "object",
        "properties": {
          "basics": {
            "$ref": "#/components/schemas/ResumeBasics"
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResumeLink"
            }
          },
          "experience": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResumeExperience"
            }
          },
          "education": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResumeEducation"
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResumeSkillGroup"
            }
          },
          "techStack": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResumeTech"
            }
          }
        },
        "description": "The whole résumé in one language."
      },
      "ResumeSkillGroup": {
        "required": [
          "category",
          "items"
        ],
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "description": "A category of skills (\"Back-end\", \"Front-end\" …) with its items, in display order."
      },
      "ResumeTech": {
        "required": [
          "id",
          "name",
          "description"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "description": "One technology of the stack (a keycap of the keyboard hero). `id` is a language-neutral slug\n(`csharp`, `postgresql`), identical in both files; `name` and `description` are localized."
      },
      "SiteInfoDto": {
        "required": [
          "name",
          "social",
          "features"
        ],
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/components/schemas/SiteNameDto"
          },
          "social": {
            "$ref": "#/components/schemas/SocialLinksDto"
          },
          "features": {
            "$ref": "#/components/schemas/PublicFeaturesDto"
          }
        },
        "description": "What every page of the front-end needs about the site itself (`GET /api/site`)."
      },
      "SiteNameDto": {
        "required": [
          "fa",
          "en"
        ],
        "type": "object",
        "properties": {
          "fa": {
            "type": "string"
          },
          "en": {
            "type": "string"
          }
        },
        "description": "The site name in both languages. Both are sent at once: the response is the same for every page and locale,\nso it can be cached as one entry (and the language switcher needs the other name anyway)."
      },
      "SocialLinksDto": {
        "required": [
          "email",
          "gitHub",
          "telegram"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "gitHub": {
            "type": [
              "null",
              "string"
            ],
            "format": "uri"
          },
          "telegram": {
            "type": [
              "null",
              "string"
            ],
            "format": "uri"
          }
        },
        "description": "Contact links; `null` = not configured, the front-end hides it."
      }
    }
  },
  "tags": [
    {
      "name": "Site"
    },
    {
      "name": "Resume"
    },
    {
      "name": "Auth"
    },
    {
      "name": "Admin"
    }
  ]
}