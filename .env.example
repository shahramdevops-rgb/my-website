# Copy to `.env` (git-ignored) and fill in real values. Every variable the stack reads is listed here.
# Docker Compose reads this file automatically for ${...} substitution in compose*.yaml.

# --- PostgreSQL (db service) ---
POSTGRES_DB=site
POSTGRES_USER=site
POSTGRES_PASSWORD=change-me
# Avoid ';' in the password: it is pasted into the connection string below.

# --- App database connection (ConnectionStrings__Default) ---
# In Docker, compose.yaml builds it from the POSTGRES_* values above, so you don't set it here.
# For `dotnet watch` on the host, store it in user-secrets (outside the repo) instead:
#   dotnet user-secrets set "ConnectionStrings:Default" "Host=localhost;Port=5433;Database=site;Username=site;Password=<POSTGRES_PASSWORD>" --project src/PersonalSite.Api

# --- API (api service) ---
# Double underscore = nested config key: Site__BaseUrl  ->  "Site": { "BaseUrl": ... }
# Canonical public URL (architecture.md §9.1). Validated at startup: must be absolute.
# Default comes from appsettings.json; dev compose sets http://localhost:8080. Production passes it in P4-T1.
Site__BaseUrl=https://mahdiazghandi.ir
# Contact links (footer, contact page; each optional, unset = hidden). GitHub/Telegram must be https URLs.
# Site__Social__Email=
# Site__Social__GitHub=https://github.com/<user>
# Site__Social__Telegram=https://t.me/<user>
# Public name per language (defaults in appsettings.json; must not be empty).
# Site__Name__Fa=
# Site__Name__En=

# --- Front-end (frontend service) ---
# Where the Next.js server calls the API directly (not via Caddy). Validated at start (frontend/src/lib/env.ts).
# Host `pnpm dev` uses frontend/.env.development (http://localhost:5080); compose sets http://api:8080.
# API_INTERNAL_URL=http://api:8080

# --- Feature flags (CLAUDE.md §10) ---
# Defaults live in appsettings.json ("FeatureManagement"); override one with FeatureManagement__<Name>=true|false.
# Don't turn a flag on unless Mahdi asks. Example:
# FeatureManagement__Analytics.Umami=true
