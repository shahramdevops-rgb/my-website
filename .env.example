# Copy to `.env` (git-ignored) and fill in real values. Every variable the stack reads is listed here.
# Docker Compose reads this file automatically for ${...} substitution in compose*.yaml.

# --- PostgreSQL (db service) ---
POSTGRES_DB=site
POSTGRES_USER=site
POSTGRES_PASSWORD=change-me
# Avoid ';' in the password: it is pasted into the connection string below.

# --- App database connection (ConnectionStrings__Default) ---
# In Docker, compose.yaml builds it from the POSTGRES_* values above, so you don't set it here.
# For `dotnet watch` on the host, store it in user-secrets (outside the repo) instead:
#   dotnet user-secrets set "ConnectionStrings:Default" "Host=localhost;Port=5433;Database=site;Username=site;Password=<POSTGRES_PASSWORD>" --project src/PersonalSite.Web

# --- App (web service) ---
# Double underscore = nested config key: Site__BaseUrl  ->  "Site": { "BaseUrl": ... }
# Canonical public URL (architecture.md §9.1). Validated at startup: must be absolute.
# Default comes from appsettings.json; dev compose sets http://localhost:8080. Production passes it in P3-T1.
Site__BaseUrl=https://mahdiazghandi.ir
# Time zone for displayed dates (IANA ID; DB stays UTC). Default in code: Asia/Tehran.
# Site__TimeZone=Asia/Tehran
# Contact links in the footer (each optional; unset = hidden). GitHub/Telegram must be https URLs.
# Site__Social__Email=
# Site__Social__GitHub=https://github.com/<user>
# Site__Social__Telegram=https://t.me/<user>

# Site languages = URL prefixes (/fa/...). Defaults in appsettings.json; validated at startup. English arrives in P1-T11:
# Localization__SupportedCultures__0=fa
# Localization__SupportedCultures__1=en
# Localization__DefaultCulture=fa
