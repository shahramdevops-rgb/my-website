@*
  Theme switch. Behaviour: wwwroot/js/components/theme-toggle.js + stores/theme.js. aria-pressed="false" is only the
  server's first guess (it can't read localStorage); Alpine sets the real value as soon as it starts.
  The icon follows data-theme through CSS (dark:/light: variants), so it is right before any JS runs.
*@
<button type="button" x-data="themeToggle" x-on:click="toggle" x-bind:aria-pressed="pressed" aria-pressed="false"
        title="@T["Theme.Light"]" class="invisible flex rounded-lg p-2 hover:bg-surface-2 hover:text-primary">
  <span class="sr-only">@T["Theme.Light"]</span>
  <span class="light:hidden"><partial name="Icons/_MoonLeaf" /></span>
  <span class="dark:hidden"><partial name="Icons/_Sun" /></span>
</button>
