@using Microsoft.Extensions.Options
@using PersonalSite.Web.Configuration
@using PersonalSite.Web.Formatting
@inject IOptions<SiteOptions> SiteOptions
@inject DateDisplay Dates
@{
    var social = SiteOptions.Value.Social;
    const string linkClass = "flex size-10 items-center justify-center rounded-full text-muted hover:bg-surface-2 hover:text-primary";
}
<footer class="border-t">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-4 py-6 sm:flex-row sm:justify-between sm:px-6">
    @* Icon-only links: the visually hidden text is what screen readers announce. rel="me" = "this profile is mine". *@
    <ul class="flex items-center gap-1" aria-label="@T["Footer.Contact"]">
      @if (social.Email is { } email)
      {
        <li><a href="mailto:@email" class="@linkClass"><partial name="Icons/_Mail" /><span class="sr-only">@T["Footer.Email"]</span></a></li>
      }
      @if (social.GitHub is { } github)
      {
        <li><a href="@github" rel="me" class="@linkClass"><partial name="Icons/_GitHub" /><span class="sr-only">@T["Footer.GitHub"]</span></a></li>
      }
      @if (social.Telegram is { } telegram)
      {
        <li><a href="@telegram" rel="me" class="@linkClass"><partial name="Icons/_Telegram" /><span class="sr-only">@T["Footer.Telegram"]</span></a></li>
      }
    </ul>
    <p class="text-sm text-muted">@T["Footer.Copyright", Dates.FormatCurrentYear(), T["Site.Name"]]</p>
  </div>
</footer>
