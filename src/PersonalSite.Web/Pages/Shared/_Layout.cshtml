@using System.Globalization
@{
    // Set per request by RequestLocalization from the URL prefix (/fa → fa). lang helps screen readers and
    // search engines; dir flips the whole layout (logical CSS utilities follow it), so English later is LTR for free.
    var culture = CultureInfo.CurrentUICulture;
}
<!DOCTYPE html>
@* data-theme: dark is the default; the theme toggle (P1-T6) switches it before first paint. *@
<html lang="@culture.Name" dir="@(culture.TextInfo.IsRightToLeft ? "rtl" : "ltr")" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    @* asp-append-version: the URL changes whenever the file's content changes, so browsers never keep a stale cached copy. *@
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @* Start fetching the main font together with the CSS instead of after it. Must match the @font-face URL in
       Styles/app.css exactly, or the font downloads twice — so a plain "/" path: "~/" would be rewritten to the
       fingerprinted file name (WithStaticAssets). Fonts always need crossorigin, even from our own origin. *@
    <link rel="preload" href="/fonts/vazirmatn-33.003/Vazirmatn-Variable.woff2" as="font" type="font/woff2" crossorigin />
    @* Per-page additions (SEO tags in P9, page-specific preloads). *@
    @await RenderSectionAsync("Head", required: false)
</head>
@* Column layout: the footer stays at the bottom even on short pages. *@
<body class="flex min-h-dvh flex-col">
    @* First focusable element: keyboard users can jump past the menu. Visible only when focused. *@
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-surface focus:px-4 focus:py-2">@T["Layout.SkipToContent"]</a>

    <partial name="_Header" />

    @* tabindex="-1": lets the skip link move keyboard focus here, without making <main> a Tab stop. *@
    <main id="main" tabindex="-1" class="flex-1">
        @RenderBody()
    </main>

    <partial name="_Footer" />
</body>
</html>
