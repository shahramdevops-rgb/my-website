@using PersonalSite.Web.Infrastructure
@model bool
@*
  The menu items, rendered twice by _Header: horizontal (desktop) and stacked (mobile). Model = stacked.
  Pages that don't exist yet (About, Blog… arrive in P2+) have no URL, so they show as plain text instead of a
  broken link, and become links by themselves once the page is added.
*@
@{
    var currentPage = ViewContext.RouteData.Values["page"] as string;
}
<ul class="@(Model ? "flex flex-col gap-1" : "flex items-center gap-1")">
  @foreach (var item in MainNavigation.Items)
  {
      var url = Url.Page(item.Page);
      <li>
        @if (url is null)
        {
          <span class="block rounded-lg px-3 py-2 text-muted">@T[item.LabelKey]</span>
        }
        else if (item.Page == currentPage)
        {
          <a href="@url" aria-current="page" class="block rounded-lg bg-primary-soft px-3 py-2 font-semibold text-primary">@T[item.LabelKey]</a>
        }
        else
        {
          <a href="@url" class="block rounded-lg px-3 py-2 hover:bg-surface-2 hover:text-primary">@T[item.LabelKey]</a>
        }
      </li>
  }
</ul>
