@page
@model IndexModel
@{
    ViewData["Title"] = T["Site.Name"];
}

@* Placeholder until P2-T1 (Home page); it also shows the botanical motifs (P1-T8) until the style guide (P1-T9). *@
<div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-12 sm:px-6 md:grid-cols-2">
  <div class="relative rounded-2xl border bg-surface px-8 pb-8 pt-20">
    <div class="pointer-events-none absolute start-2 top-2 w-20 text-primary rtl:-scale-x-100"><partial name="Motifs/_VineCorner" /></div>
    <div class="flex items-center gap-3">
      <span class="w-5 shrink-0 text-primary"><partial name="Motifs/_Sprig" /></span>
      <h1 class="text-2xl font-bold text-primary">@T["Site.Name"]</h1>
    </div>
    <p class="mt-2 text-muted">@T["Home.ComingSoon"]</p>
    <div class="mt-8 w-48 text-primary"><partial name="Motifs/_LeafDivider" /></div>
    <div class="pointer-events-none absolute bottom-4 end-4 w-12 text-primary"><partial name="Motifs/_BloomCluster" /></div>
  </div>
  <div class="mx-auto w-full max-w-xs text-primary"><partial name="Motifs/_HeroBotanical" /></div>
</div>
